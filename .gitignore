# velvet-thunder: encrypted vault data + static UI ONLY
# Reject everything except what's explicitly allowed

# Block all source code (backend scripts)
*.py
*.mjs
*.ts
*.toml

# Block databases
*.db
*.sqlite

# Block logs/state
*.log
*.pid

# Block secrets
*.secret
*.token
*.key

# Block config/data files
*.json
*.yaml
*.yml
