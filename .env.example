# Environment variables for encrypt.sh / commit.sh
# Copy to .env and fill in your paths, or export these in your shell

# Path to the receipts tools directory (where receipts.db and generate-prices-db.py live)
RECEIPTS_TOOLS_DIR=/path/to/receipts

# Path to secrets JSON file containing {"passphrase": "..."}
VAULT_SECRETS_FILE=/path/to/secrets/receipts-vault.json

# Or set the passphrase directly (overrides VAULT_SECRETS_FILE)
# RECEIPTS_KEY=your-vault-passphrase
